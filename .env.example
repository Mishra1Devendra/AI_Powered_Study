# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is git-ignored. NEVER commit real credentials or paste them into chat.

# ---------- Server ----------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Set to true ONLY when the API runs behind your own reverse proxy (deploy/Caddyfile or deploy/nginx.conf): it then trusts X-Forwarded-For so each student has their own rate limit.
TRUST_PROXY=false
# Origin of the web app
WEB_ORIGIN=http://localhost:5173

# ---------- Database (Supabase PostgreSQL) ----------
# Supabase dashboard -> Connect -> Session pooler (works over IPv4, supports migrations).
# Replace [YOUR-PASSWORD] with your database password (no brackets); URL-encode special characters.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---------- Supabase project (Auth) ----------
# Supabase dashboard -> Project Settings -> API
# SUPABASE_URL and SUPABASE_ANON_KEY are PUBLIC values: they are intentionally bundled into the
# browser app. Data is protected by Row Level Security, not by hiding these.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET - server-side only, bypasses RLS. Currently unused; leave empty. It is never exposed to
# the frontend (the web build only reads the two public values above).
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI (ZERO-COST POLICY: see docs/AI_POLICY.md) ----------
# Only two providers exist: a LOCAL Ollama server (free, runs on this device) and the demo MOCK.
#   ollama (default) -> local Ollama; if it is not running, replies fall back to the labelled mock.
#   mock             -> canned demo replies only.
# Paid/cloud AI (Anthropic, OpenAI, Gemini, Azure, Bedrock...) is DISABLED. Do not add its keys here.
AI_PROVIDER=ollama
# Must be this machine (localhost / 127.0.0.1). Remote hosts and Ollama "cloud" models are refused.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Any model you have installed locally: `ollama pull llama3.2:3b`
OLLAMA_MODEL=llama3.2:3b
# Context window requested from Ollama (bigger = more RAM).
OLLAMA_NUM_CTX=8192
# Daily AI allowance of every NON-admin account, in "uses" (a chat reply is 1, a study plan / flashcards / mind map 2, a quiz 3). Administrators are never limited.
AI_DAILY_UNITS=100
# Local models can be slow on a CPU, especially on first load.
AI_TIMEOUT_MS=180000

# ---------- FREE online AI services (optional; only used when AI_PROVIDER=free) ----------
# Policy (docs/AI_POLICY.md): FREE tiers only, never paid, no card, no billing. Register ONLY with the project owner's approved address (see docs/AI_POLICY.md).
# With AI_PROVIDER=free the app tries: local Ollama -> the services below in FREE_AI_ORDER -> "AI temporarily unavailable".
# Keys are SERVER-SIDE secrets: never put them in the web app, in Git, in docs or in screenshots. Leave a key empty to skip that service.
# Models must be on the approved-free list (services/ai/free/catalog.ts); there is no endpoint/URL setting on purpose.
FREE_AI_ORDER=groq,openrouter,gemini
# first (default): the local AI answers first and the free online services are the backup (questions stay on this computer).
# last: the free online services answer first and the local AI is the last resort (questions LEAVE this computer while a service is available).
FREE_AI_LOCAL_POSITION=first
GROQ_API_KEY=
# openai/gpt-oss-20b (default) or openai/gpt-oss-120b
GROQ_MODEL=
OPENROUTER_API_KEY=
# REQUIRED to use OpenRouter: an explicit free model id ending in ":free" (ids change; see openrouter.ai/models and pick a ":free" one)
OPENROUTER_MODEL=
# Create the Gemini key in a Google project WITHOUT billing, and never enable billing on it.
GEMINI_API_KEY=
# gemini-3.5-flash-lite (default), gemini-3.5-flash, gemini-3.6-flash, gemini-3.7-flash or gemini-3.8-flash (use the model ID, not the display name)
GEMINI_MODEL=
