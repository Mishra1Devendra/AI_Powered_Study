{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "fastify",
      "entrypoint": "src/server.ts",
      "installCommand": "npm install --include=dev",
      "buildCommand": "npm run build -w @copilot/shared"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "npm install --include=dev",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
