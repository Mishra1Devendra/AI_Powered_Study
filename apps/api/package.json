{
  "name": "@copilot/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "node --env-file=../../.env ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "check:db": "tsx --env-file-if-exists=../../.env src/scripts/check-db.ts",
    "admin:promote": "tsx --env-file-if-exists=../../.env src/scripts/promote-admin.ts",
    "check:signup": "tsx --env-file-if-exists=../../.env src/scripts/check-signup.ts",
    "check:ai": "tsx --env-file-if-exists=../../.env src/scripts/ai-cost-check.ts",
    "db:generate": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=../../.env ../../node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@copilot/shared": "*",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^10.2.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "postgres": "^3.4.5",
    "unpdf": "^1.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
